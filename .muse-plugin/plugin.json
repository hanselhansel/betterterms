        "path": "skills/betterterms-discovery/SKILL.md"
      },
      {
        "id": "betterterms-exchange",
        "path": "skills/betterterms-exchange/SKILL.md"
      },
      {
        "id": "betterterms-guardrails",
        "path": "skills/betterterms-guardrails/SKILL.md"
      },
      {
        "id": "betterterms-intake",
        "path": "skills/betterterms-intake/SKILL.md"
