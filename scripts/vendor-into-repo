#!/usr/bin/env python3
"""Vendor betterterms skills into another repo for cloud sessions.

Usage: vendor-into-repo REPO

Copies every skills/betterterms-* folder into REPO/.claude/skills/ and
writes REPO/.claude/skills/.betterterms-version with this repo's
VERSION. Marketplace plugins do not load in Claude Code cloud
sessions, but committed .claude/skills do; vendoring is the way to run
betterterms there. The relative path
../betterterms-guardrails/scripts/bt.py still reaches the runtime
tool, since the skill folders stay siblings.

An existing .claude/skills/betterterms-* directory is replaced only
when it looks like a previous vendored copy (SKILL.md naming the
folder); a symlinked entry is unlinked, never written through. Exit 1
on errors, 2 on usage errors.
"""

import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SKILLS_DIR = ROOT / "skills"
VERSION_FILE = ROOT / "VERSION"


def _skills():
    return sorted(
        p for p in SKILLS_DIR.iterdir()
        if p.is_dir() and not p.is_symlink() and p.name.startswith("betterterms-")
    )


def _is_vendored(dest, name):
    skill_md = dest / "SKILL.md"
    if not skill_md.is_file():
        return False
    try:
        head = skill_md.read_text(encoding="utf-8", errors="replace")[:4096]
    except OSError:
        return False
    return f"name: {name}" in head


def main(argv):
    if len(argv) != 1 or argv[0].startswith("-"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    repo = Path(argv[0]).expanduser()
    if not repo.is_dir() or repo.is_symlink():
        print(f"error: {repo} is not a directory", file=sys.stderr)
        return 1
    target = repo / ".claude" / "skills"
    if not target.resolve().is_relative_to(repo.resolve()):
        print(
            f"refusing: {target} resolves outside {repo} through a symlink",
            file=sys.stderr,
        )
        return 1

    problems = []
    for skill in _skills():
        dest = target / skill.name
        if dest.is_symlink() or not dest.exists():
            continue
        if not dest.is_dir():
            problems.append(f"{dest}: exists and is not a directory")
        elif not _is_vendored(dest, skill.name):
            problems.append(f"{dest}: not a vendored betterterms copy")
    if problems:
        for p in problems:
            print(f"refusing: {p}", file=sys.stderr)
        return 1

    target.mkdir(parents=True, exist_ok=True)
    for skill in _skills():
        dest = target / skill.name
        if dest.is_symlink():
            dest.unlink()
            action = "replaced link"
        elif dest.is_dir():
            shutil.rmtree(dest)
            action = "updated"
        else:
            action = "vendored"
        shutil.copytree(
            skill, dest, ignore=shutil.ignore_patterns("__pycache__")
        )
        print(f"{action} {skill.name}")
    marker = target / ".betterterms-version"
    marker.write_text(VERSION_FILE.read_text(encoding="utf-8"), encoding="utf-8")
    print(f"wrote .betterterms-version ({marker.read_text().strip()})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
