#!/usr/bin/env python3
"""Write VERSION and regenerate manifests.

Usage: bump-version --check | <new-version>
  --check        verify every generated manifest's version equals VERSION
  <new-version>  X.Y.Z; writes VERSION, then reruns scripts/build
"""

import importlib.machinery
import importlib.util
import json
import re
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# ASCII digits only, no leading zeros; always compared with fullmatch so
# trailing newlines or Unicode digits cannot slip through.
SEMVER = re.compile(r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)")
HEADING = re.compile(r"^##\s+(\S+)")


def _build_module():
    path = ROOT / "scripts" / "build"
    loader = importlib.machinery.SourceFileLoader("bt_build", str(path))
    spec = importlib.util.spec_from_loader("bt_build", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def _top_changelog_version():
    """The X.Y.Z in the first '## <ver>' heading of CHANGELOG.md, or None
    when the file is missing or has no version heading."""
    path = ROOT / "CHANGELOG.md"
    if not path.is_file():
        return None
    for line in path.read_text(encoding="utf-8").splitlines():
        m = HEADING.match(line)
        if m and SEMVER.fullmatch(m.group(1)):
            return m.group(1)
    return None


def check():
    version_file = ROOT / "VERSION"
    if not version_file.is_file():
        print("VERSION file missing", file=sys.stderr)
        return 2
    version = version_file.read_text().strip()
    if not SEMVER.fullmatch(version):
        print(f"VERSION {version!r} is not X.Y.Z semver", file=sys.stderr)
        return 2
    problems = []
    top = _top_changelog_version()
    if top != version:
        problems.append(
            f"CHANGELOG.md: top version heading {top!r} != VERSION {version!r}"
        )
    for rel in sorted(_build_module().expected(ROOT)):
        path = ROOT / rel
        if not path.is_file():
            continue  # unbuilt manifests are build-fresh's problem
        try:
            data = json.loads(path.read_text())
        except (json.JSONDecodeError, UnicodeDecodeError):
            continue  # non-JSON generated files carry no version field
        if isinstance(data, dict) and "version" in data and str(data["version"]) != version:
            problems.append(f"{rel}: version {data['version']!r} != VERSION {version!r}")
    if problems:
        print("versions out of sync:", file=sys.stderr)
        for p in problems:
            print(f"  {p}", file=sys.stderr)
        print("run scripts/bump-version", file=sys.stderr)
        return 1
    print(f"version check passed ({version})")
    return 0


def bump(new):
    if not SEMVER.fullmatch(new):
        print(f"bad version {new!r}; expected X.Y.Z", file=sys.stderr)
        return 2
    version_file = ROOT / "VERSION"
    old = version_file.read_text() if version_file.is_file() else None
    version_file.write_text(new + "\n")
    result = subprocess.run(
        [sys.executable, str(ROOT / "scripts" / "build")], cwd=ROOT
    )
    if result.returncode != 0:
        if old is None:
            version_file.unlink(missing_ok=True)
            print("build failed; removed VERSION (it did not exist before)", file=sys.stderr)
        else:
            version_file.write_text(old)
            print(f"build failed; restored VERSION to {old.strip()!r}", file=sys.stderr)
        return result.returncode or 1
    print(f"VERSION set to {new}")
    return 0


def main(argv):
    if argv == ["--check"]:
        return check()
    if len(argv) == 1:
        return bump(argv[0])
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
