#!/usr/bin/env python3
"""Write VERSION and regenerate manifests.

Usage: bump-version --check | <new-version>
  --check        verify every generated manifest's version equals VERSION
  <new-version>  X.Y.Z, strictly above the current VERSION; computes all
                 build outputs with the new version first, then writes
                 VERSION and every generated file; any write target that
                 resolves outside the repo, goes through a symlink or
                 exists as a non-regular file is refused; on any write
                 failure every touched file is restored to its prior
                 bytes (restore failures are listed, then the original
                 error propagates)
"""

import importlib.machinery
import importlib.util
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# ASCII digits only, no leading zeros; always compared with fullmatch so
# trailing newlines or Unicode digits cannot slip through.
SEMVER = re.compile(r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)")


def _build_module():
    path = ROOT / "scripts" / "build"
    loader = importlib.machinery.SourceFileLoader("bt_build", str(path))
    spec = importlib.util.spec_from_loader("bt_build", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


def check():
    version_file = ROOT / "VERSION"
    if not version_file.is_file():
        print("VERSION file missing", file=sys.stderr)
        return 2
    version = version_file.read_text(encoding="utf-8").strip()
    if not SEMVER.fullmatch(version):
        print(f"VERSION {version!r} is not X.Y.Z semver", file=sys.stderr)
        return 2
    problems = []
    for rel in sorted(_build_module().expected(ROOT, version)):
        path = ROOT / rel
        if not path.is_file():
            continue  # unbuilt manifests are build-fresh's problem
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
        except (json.JSONDecodeError, UnicodeDecodeError):
            continue  # non-JSON generated files carry no version field
        if isinstance(data, dict) and "version" in data and str(data["version"]) != version:
            problems.append(f"{rel}: version {data['version']!r} != VERSION {version!r}")
    if problems:
        print("versions out of sync:", file=sys.stderr)
        for p in problems:
            print(f"  {p}", file=sys.stderr)
        print("run scripts/build", file=sys.stderr)
        return 1
    print(f"version check passed ({version})")
    return 0


def _semver_tuple(v):
    m = SEMVER.fullmatch(v)
    return tuple(int(g) for g in m.groups()) if m else None


def bump(new):
    if not SEMVER.fullmatch(new):
        print(f"bad version {new!r}; expected X.Y.Z", file=sys.stderr)
        return 2
    version_file = ROOT / "VERSION"
    cur_text = (
        version_file.read_text(encoding="utf-8").strip()
        if version_file.is_file()
        else ""
    )
    cur = _semver_tuple(cur_text)
    if cur is not None and _semver_tuple(new) <= cur:
        print(
            f"version {new} is not above current VERSION {cur_text}",
            file=sys.stderr,
        )
        return 2
    # Compute every build output with the new version before touching
    # the tree, then refuse any write target that would land outside
    # the repo through a link or overwrite a non-regular file.
    build_mod = _build_module()
    files = build_mod.expected(ROOT, new)
    targets = [version_file, *(ROOT / rel for rel in files)]
    for path in targets:
        build_mod._check_write_path(path)
    touched = {}
    for path in targets:
        touched[path] = path.read_bytes() if path.is_file() else None
    done = False
    try:
        version_file.write_text(new + "\n", encoding="utf-8")
        for rel, content in sorted(files.items()):
            path = ROOT / rel
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content, encoding="utf-8")
        done = True
    finally:
        if not done:
            # Every restore is attempted even when one fails; the
            # original write error still propagates afterwards.
            failures = []
            for path, old in touched.items():
                try:
                    if old is None:
                        path.unlink(missing_ok=True)
                    else:
                        path.write_bytes(old)
                except Exception as e:
                    failures.append(f"{path}: {e}")
            if failures:
                print("bump failed and rollback did not restore:",
                      file=sys.stderr)
                for f in failures:
                    print(f"  {f}", file=sys.stderr)
            else:
                print("bump failed; restored every touched file",
                      file=sys.stderr)
    print(f"VERSION set to {new}")
    return 0


def main(argv):
    if argv == ["--check"]:
        return check()
    if len(argv) == 1:
        try:
            return bump(argv[0])
        except Exception as e:
            print(f"bump-version: {e}", file=sys.stderr)
            return 1
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
