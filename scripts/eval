#!/usr/bin/env python3
"""Eval runner for betterterms.

  scripts/eval --smoke     offline checks (default; no LLM calls)
  scripts/eval --dev       promptfoo eval on the dev suite; prints the
                           pass rate
  scripts/eval --holdout   promptfoo eval on the holdout config from
                           $BETTERTERMS_HOLDOUT (default
                           ~/.betterterms-holdout); exits 2 when absent

Smoke checks, all offline: fixture case files parse and pass
`bt.py case show` (and never echo the floor); every dev case file
parses, names a real fixture, and carries a python plus an llm-rubric
assertion; the canned outputs under evals/fixtures/canned score as
expected through assert_gate.get_assert.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
EVALS = REPO / "evals"
FIXTURES = EVALS / "fixtures" / "cases"
CANNED = EVALS / "fixtures" / "canned"
DEV_CASES = EVALS / "cases" / "dev"
CONFIG = EVALS / "promptfooconfig.yaml"
BT_DIR = REPO / "skills" / "betterterms-guardrails" / "scripts"
BT = BT_DIR / "bt.py"

sys.path.insert(0, str(BT_DIR))
sys.path.insert(0, str(REPO / "evals" / "harness"))

import assert_gate  # noqa: E402
from btlib import yaml  # noqa: E402

_failures = []


def _report(name, ok, detail=""):
    status = "PASS" if ok else "FAIL"
    print(f"{status} {name}" + (f": {detail}" if detail else ""))
    if not ok:
        _failures.append(name)


def _load_yaml_file(path):
    try:
        data = yaml.load(path.read_text(encoding="utf-8"))
    except yaml.Error as e:
        return None, f"{path.name}: {e}"
    if not isinstance(data, dict):
        return None, f"{path.name}: expected a mapping"
    return data, ""


def _check_fixture(case_dir, home):
    cid = case_dir.name
    floor_path = case_dir / ".floor"
    floor_text = None
    for name in ("brief.yaml", "plan.yaml"):
        path = case_dir / name
        if not path.is_file():
            return f"{name} missing"
        _, err = _load_yaml_file(path)
        if err:
            return err
    if not floor_path.is_file():
        return ".floor missing"
    floor_text = floor_path.read_text(encoding="utf-8").strip()
    try:
        float(floor_text)
    except ValueError:
        return ".floor: not a number"

    dst = home / "cases" / cid
    shutil.copytree(case_dir, dst)
    os.chmod(dst / ".floor", 0o600)
    r = subprocess.run(
        [sys.executable, str(BT), "case", "show", cid],
        env={**os.environ, "BETTERTERMS_HOME": str(home)},
        capture_output=True,
        text=True,
        timeout=60,
    )
    if r.returncode != 0:
        return f"case show exit {r.returncode}: {(r.stdout or r.stderr).strip()}"
    out = json.loads(r.stdout)
    if not out.get("brief") or not out.get("plan"):
        return "case show returned an empty brief or plan"
    if _has_floor_key(out):
        return "case show exposed a floor field"
    return ""


def _has_floor_key(node):
    if isinstance(node, dict):
        return any(
            k == "floor" or _has_floor_key(v) for k, v in node.items()
        )
    if isinstance(node, list):
        return any(_has_floor_key(item) for item in node)
    return False


def _check_dev_case(path, fixture_ids):
    data, err = _load_yaml_file(path)
    if err:
        return err
    v = data.get("vars")
    if not isinstance(v, dict):
        return "vars missing"
    if v.get("case_id") not in fixture_ids:
        return f"vars.case_id {v.get('case_id')!r} has no fixture case"
    msg = v.get("counterparty_message")
    if not isinstance(msg, str) or not msg.strip():
        return "vars.counterparty_message missing"
    asserts = data.get("assert")
    if not isinstance(asserts, list) or not asserts:
        return "assert missing or empty"
    types = {a.get("type") for a in asserts if isinstance(a, dict)}
    if "python" not in types or "llm-rubric" not in types:
        return "needs a python and an llm-rubric assertion"
    return ""


def _check_canned(path):
    parts = path.name.split(".")
    if len(parts) < 3 or parts[-1] != "txt":
        return "name must be <case_id>.<expected>.txt"
    case_id = ".".join(parts[:-2])
    want_pass = parts[-2] == "pass"
    result = assert_gate.get_assert(
        path.read_text(encoding="utf-8"), {"vars": {"case_id": case_id}}
    )
    if bool(result.get("pass")) == want_pass:
        return ""
    return f"expected {'pass' if want_pass else 'fail'}: {result.get('reason')}"


def cmd_smoke():
    if not FIXTURES.is_dir():
        print("FAIL smoke: evals/fixtures/cases missing")
        return 1
    fixture_ids = {d.name for d in FIXTURES.iterdir() if d.is_dir()}
    with tempfile.TemporaryDirectory() as td:
        home = Path(td) / "home"
        (home / "cases").mkdir(parents=True)
        for name in sorted(fixture_ids):
            _report(f"smoke fixture {name}", not (why := _check_fixture(FIXTURES / name, home)), why)
    if DEV_CASES.is_dir():
        for path in sorted(DEV_CASES.glob("*.yaml")):
            _report(f"smoke dev-case {path.stem}", not (why := _check_dev_case(path, fixture_ids)), why)
    else:
        _report("smoke dev-cases", False, "evals/cases/dev missing")
    if CANNED.is_dir():
        for path in sorted(CANNED.glob("*.txt")):
            _report(f"smoke canned {path.stem}", not (why := _check_canned(path)), why)
    print(f"smoke: {len(_failures)} failed")
    return 1 if _failures else 0


def _print_pass_rate(out_path):
    try:
        data = json.loads(out_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return
    stats = (data.get("results") or {}).get("stats") or data.get("stats") or {}
    s = stats.get("successes", 0)
    total = s + stats.get("failures", 0) + stats.get("errors", 0)
    if total:
        print(f"pass rate: {s}/{total} ({100.0 * s / total:.1f}%)")


def _run_promptfoo(config):
    if shutil.which("promptfoo") is None:
        print("promptfoo not installed")
        return 2
    with tempfile.TemporaryDirectory() as td:
        out = Path(td) / "results.json"
        r = subprocess.run(
            ["promptfoo", "eval", "-c", str(config), "-o", str(out),
             "--no-progress-bar"],
            cwd=REPO,
        )
        _print_pass_rate(out)
        return r.returncode


def cmd_dev():
    return _run_promptfoo(CONFIG)


def cmd_holdout():
    root = Path(
        os.environ.get("BETTERTERMS_HOLDOUT") or "~/.betterterms-holdout"
    ).expanduser()
    config = root / "promptfooconfig.yaml"
    if not config.is_file():
        print(f"no holdout config at {config}")
        return 2
    return _run_promptfoo(config)


def main(argv):
    p = argparse.ArgumentParser(prog="scripts/eval", description=__doc__)
    g = p.add_mutually_exclusive_group()
    g.add_argument("--smoke", action="store_true", help="offline checks (default)")
    g.add_argument("--dev", action="store_true", help="run the dev suite")
    g.add_argument("--holdout", action="store_true", help="run the holdout suite")
    args = p.parse_args(argv)
    if args.dev:
        return cmd_dev()
    if args.holdout:
        return cmd_holdout()
    return cmd_smoke()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
