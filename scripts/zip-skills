#!/usr/bin/env python3
"""Package each betterterms skill as its own zip for claude.ai upload.

Usage: zip-skills

Writes dist/betterterms-<name>.zip, one archive per skills/
betterterms-* folder, each entry prefixed with the skill folder name
so an unzip yields betterterms-<name>/SKILL.md, ... . dist/ is
gitignored. Archives are deterministic: sorted entries, fixed
timestamps, no __pycache__ or OS cruft.
"""

import sys
import zipfile
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _lib.checks_scan import junk_file

ROOT = Path(__file__).resolve().parent.parent
SKILLS_DIR = ROOT / "skills"
DIST = ROOT / "dist"
# ZIP timestamps cannot precede 1980; any fixed value past that keeps
# two runs byte-identical.
FIXED_DATE = (2020, 1, 1, 0, 0, 0)


def _skills():
    return sorted(
        p for p in SKILLS_DIR.iterdir()
        if p.is_dir() and not p.is_symlink() and p.name.startswith("betterterms-")
    )


def _members(skill):
    return [
        f for f in sorted(skill.rglob("*"))
        if f.is_file()
        and not f.is_symlink()
        and "__pycache__" not in f.parts
        and not junk_file(f.name)
    ]


def main(argv):
    if argv:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    DIST.mkdir(exist_ok=True)
    for skill in _skills():
        out = DIST / f"{skill.name}.zip"
        with zipfile.ZipFile(out, "w", zipfile.ZIP_DEFLATED) as z:
            for f in _members(skill):
                arc = f"{skill.name}/{f.relative_to(skill).as_posix()}"
                info = zipfile.ZipInfo(arc, date_time=FIXED_DATE)
                info.compress_type = zipfile.ZIP_DEFLATED
                info.external_attr = 0o644 << 16
                z.writestr(info, f.read_bytes())
        print(f"wrote dist/{out.name}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
