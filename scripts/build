#!/usr/bin/env python3
"""Regenerate host manifests from kit.config.json + VERSION.

Each generator in GENERATORS is a callable ``gen(root) -> {relpath:
content}`` producing repo-relative files (`.claude-plugin/plugin.json`,
`plugin.json`, `gemini-extension.json`, `commands/*.md`, ...). When
GENERATORS is empty, build is a no-op and --check passes.

Whenever generators produce output, build also writes `.generated-files`
at the root listing the sorted generated relpaths; `--check` fails on
paths a previous manifest lists that are no longer generated (orphans).

Usage: build [--check]
  (no args)   write every generated file
  --check     exit 1 if any generated file is missing or differs
"""

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

GENERATORS = []

MANIFEST = ".generated-files"


def expected(root):
    """Return {relpath: content} for every registered generator."""
    out = {}
    for gen in GENERATORS:
        for rel, content in gen(root).items():
            if rel in out:
                raise ValueError(f"two generators produce {rel}")
            out[rel] = content
    return out


def outputs(root):
    """Generated files plus, when any exist, the `.generated-files`
    manifest recording their sorted relpaths."""
    files = expected(root)
    if files:
        files[MANIFEST] = "".join(f"{rel}\n" for rel in sorted(files))
    return files


def main(argv):
    if argv and argv != ["--check"]:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    files = outputs(ROOT)
    manifest = ROOT / MANIFEST
    previous = manifest.read_text().splitlines() if manifest.is_file() else []
    if "--check" in argv:
        stale = [
            rel
            for rel, content in sorted(files.items())
            if not (ROOT / rel).is_file() or (ROOT / rel).read_text() != content
        ]
        orphans = [rel for rel in previous if rel not in files]
        if stale or orphans:
            print("generated files out of date:", file=sys.stderr)
            for rel in stale:
                print(f"  {rel}", file=sys.stderr)
            for rel in orphans:
                print(f"  {rel} (no longer generated)", file=sys.stderr)
            print("run scripts/build", file=sys.stderr)
            return 1
        print("build check passed" if files else "build check passed (no generators registered)")
        return 0
    for rel in previous:
        # Drop files the last build generated that are orphaned now.
        path = ROOT / rel
        if rel not in files and path.is_file() and path.resolve().is_relative_to(ROOT):
            path.unlink()
            print(f"deleted orphan {rel}")
    for rel, content in sorted(files.items()):
        path = ROOT / rel
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)
        print(f"wrote {rel}")
    if not files:
        manifest.unlink(missing_ok=True)
        print("no generators registered; nothing to build")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
