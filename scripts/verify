#!/usr/bin/env python3
"""Repo verification checks.

Usage: python3 scripts/verify [ROOT]

ROOT defaults to the repo containing this script and must be a directory
holding VERSION and kit.config.json; anything else exits 2. Prints one
line per check: `PASS <name>`, `FAIL <name>: <reason>`, or
`SKIP <name>: <reason>`. Exits 1 when any check FAILs. Checks live in
the CHECKS registry so later steps can add more.
"""

import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from _lib import frontmatter

REPO_ROOT = Path(__file__).resolve().parent.parent

# Skipped directory names. SKIP_DIRS_ANYWHERE applies at every level;
# SKIP_DIRS_TOP applies only to direct children of the root, so a nested
# .venv or dist under a package is still scanned.
SKIP_DIRS_ANYWHERE = {".git", "__pycache__", "node_modules"}
SKIP_DIRS_TOP = {
    ".claude", ".venv", "venv", "dist", "holdout", ".idea",
    ".mypy_cache", ".pytest_cache", ".ruff_cache", ".promptfoo",
}

# Internal documentation directories (repo-relative path prefixes) hold
# research, specs, plans and decisions that quote prose freely and may
# embed local paths, so both prose-rules and no-local-paths skip them.
# docs/guides and everything else shipped IS checked. tests/ is also
# exempt from no-local-paths (fixtures may legitimately embed paths).
INTERNAL_DOCS = {
    ("docs", "research"), ("docs", "specs"),
    ("docs", "plans"), ("docs", "decisions"),
}

SKILL_NAME = re.compile(r"^[a-z0-9-]{1,64}$")
ALLOWED_FM_KEYS = {
    "name", "description", "license", "compatibility",
    "metadata", "allowed-tools",
}
BANNED_WORDS = re.compile(
    r"\b(delv\w*|pivotal|crucial|showcas\w*|leverag\w*|robust|comprehensive|"
    r"nuanced|underscor\w*|foster\w*|moreover|furthermore)\b",
    re.IGNORECASE,
)
EM_DASH = "\u2014"
# Written as char classes / ranges so the pattern does not match this line.
# Flags user home paths; dotfiles under home stay allowed.
LOCAL_PATH = re.compile(
    r"[/]Users/|/home/[\w.-]+/|~/[A-Za-z0-9_]|[A-Za-z]:\\Users\\",
    re.IGNORECASE,
)
MAX_SOURCE_LINES = 400
MAX_SKILL_BODY_LINES = 500
MAX_DESCRIPTION_CHARS = 1024
UNIT_TEST_TIMEOUT = 300
SUBPROCESS_TIMEOUT = 120


def _is_internal_doc(rel):
    return any(rel.parts[: len(skip)] == skip for skip in INTERNAL_DOCS)


def _skipped(parts):
    """Whether a path's directory parts hit a skip rule."""
    return bool(parts) and (
        parts[0] in SKIP_DIRS_TOP
        or any(part in SKIP_DIRS_ANYWHERE for part in parts)
    )


def _git_relpaths(root):
    """Tracked plus non-ignored untracked files when root is a git repo;
    None when not, so callers fall back to os.walk."""
    if not (root / ".git").exists():
        return None
    try:
        r = subprocess.run(
            ["git", "ls-files", "--cached", "--others",
             "--exclude-standard", "-z"],
            cwd=root, capture_output=True, text=True,
            timeout=SUBPROCESS_TIMEOUT,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if r.returncode != 0:
        return None
    return r.stdout.split("\0")


def _files(root):
    """Yield files under root, honoring SKIP_DIRS_TOP at the top level and
    SKIP_DIRS_ANYWHERE everywhere. When root is a git repo only tracked or
    non-ignored untracked files are walked."""
    rels = _git_relpaths(root)
    if rels is not None:
        for rel in rels:
            if not rel:
                continue
            p = root / rel
            if p.is_file() and not _skipped(Path(rel).parts):
                yield p
        return
    for dirpath, dirnames, filenames in os.walk(root):
        rel = Path(dirpath).relative_to(root)
        top = not rel.parts
        dirnames[:] = [
            d
            for d in dirnames
            if d not in SKIP_DIRS_ANYWHERE and not (top and d in SKIP_DIRS_TOP)
        ]
        for name in filenames:
            if name == ".git":  # worktree marker is a file, not a dir
                continue
            yield Path(dirpath) / name


def _tail(result, n=5):
    text = (result.stderr or "") + (result.stdout or "")
    return " | ".join(text.strip().splitlines()[-n:])


def _join(items, n=8):
    shown = items[:n]
    if len(items) > n:
        shown.append(f"+{len(items) - n} more")
    return "; ".join(shown)


# --- checks ------------------------------------------------------------------

def check_unit_tests(root):
    if not (root / "tests").is_dir():
        return "SKIP", "no tests/ directory"
    r = subprocess.run(
        [sys.executable, "-m", "unittest", "discover", "-s", "tests"],
        cwd=root, capture_output=True, text=True, timeout=UNIT_TEST_TIMEOUT,
    )
    return ("PASS", "") if r.returncode == 0 else ("FAIL", _tail(r))


def check_skill_names(root):
    skills = root / "skills"
    if not skills.is_dir():
        return "SKIP", "no skills/ directory"
    problems = []
    for folder in sorted(skills.iterdir()):
        if not folder.is_dir():
            continue
        name = folder.name
        if not SKILL_NAME.match(name) or not name.startswith("betterterms-"):
            problems.append(f"skills/{name}: folder must be betterterms-[a-z0-9-]")
        skill_md = folder / "SKILL.md"
        if not skill_md.is_file():
            problems.append(f"skills/{name}: missing SKILL.md")
            continue
        try:
            fm, body = frontmatter.parse(skill_md)
        except Exception as e:
            problems.append(f"skills/{name}: {e}")
            continue
        extra = sorted(str(k) for k in fm if k not in ALLOWED_FM_KEYS)
        if extra:
            problems.append(
                f"skills/{name}: unexpected frontmatter keys: {', '.join(extra)}"
            )
        if fm.get("name") != name:
            problems.append(f"skills/{name}: name {fm.get('name')!r} != folder")
        desc = fm.get("description")
        if not isinstance(desc, str) or not desc.strip():
            problems.append(f"skills/{name}: missing description")
        elif len(desc) > MAX_DESCRIPTION_CHARS:
            problems.append(f"skills/{name}: description {len(desc)} chars > {MAX_DESCRIPTION_CHARS}")
        body_lines = len(body.splitlines())
        if body_lines > MAX_SKILL_BODY_LINES:
            problems.append(f"skills/{name}: body {body_lines} lines > {MAX_SKILL_BODY_LINES}")
    return ("FAIL", _join(problems)) if problems else ("PASS", "")


def check_no_bin(root):
    if (root / "bin").exists():
        return "FAIL", "top-level bin/ is not allowed"
    return "PASS", ""


def check_no_root_claude_md(root):
    bad = [
        str(p.relative_to(root))
        for p in _files(root)
        if p.name.lower() in ("claude.md", "agents.md")
    ]
    return ("FAIL", _join(bad)) if bad else ("PASS", "")


def check_no_local_paths(root):
    bad = []
    for p in _files(root):
        rel = p.relative_to(root)
        if rel.parts[0] == "tests" or _is_internal_doc(rel):
            continue
        try:
            text = p.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        for i, line in enumerate(text.splitlines(), 1):
            if LOCAL_PATH.search(line):
                bad.append(f"{rel}:{i}")
    return ("FAIL", _join(bad)) if bad else ("PASS", "")


def check_prose_rules(root):
    bad = []
    for p in _files(root):
        rel = p.relative_to(root)
        if p.suffix != ".md" or _is_internal_doc(rel):
            continue
        try:
            text = p.read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        for i, line in enumerate(text.splitlines(), 1):
            if EM_DASH in line:
                bad.append(f"{rel}:{i}: em dash")
            m = BANNED_WORDS.search(line)
            if m:
                bad.append(f"{rel}:{i}: banned word {m.group(0)!r}")
    return ("FAIL", _join(bad)) if bad else ("PASS", "")


def check_file_size(root):
    bad = []
    for p in _files(root):
        rel = p.relative_to(root)
        is_source = p.suffix in (".py", ".js") or (
            rel.parts and rel.parts[0] == "scripts" and "." not in p.name
        )
        if not is_source:
            continue
        try:
            n = len(p.read_text(encoding="utf-8").splitlines())
        except (OSError, UnicodeDecodeError):
            continue
        if n > MAX_SOURCE_LINES:
            bad.append(f"{rel} ({n} lines > {MAX_SOURCE_LINES})")
    return ("FAIL", _join(bad)) if bad else ("PASS", "")


def _run_script(root, name, *args):
    path = root / "scripts" / name
    if not path.is_file():
        return "SKIP", f"no scripts/{name}"
    r = subprocess.run(
        [sys.executable, str(path), *args],
        cwd=root, capture_output=True, text=True, timeout=SUBPROCESS_TIMEOUT,
    )
    return ("PASS", "") if r.returncode == 0 else ("FAIL", _tail(r))


def check_build_fresh(root):
    return _run_script(root, "build", "--check")


def check_version_sync(root):
    return _run_script(root, "bump-version", "--check")


def check_claude_validate(root):
    if not (root / ".claude-plugin" / "plugin.json").is_file():
        return "SKIP", "no .claude-plugin/plugin.json"
    if shutil.which("claude") is None:
        return "SKIP", "claude not installed"
    r = subprocess.run(
        ["claude", "plugin", "validate", "."],
        cwd=root, capture_output=True, text=True, timeout=SUBPROCESS_TIMEOUT,
    )
    return ("PASS", "") if r.returncode == 0 else ("FAIL", _tail(r))


def check_gemini_validate(root):
    if not (root / "gemini-extension.json").is_file():
        return "SKIP", "no gemini-extension.json"
    if shutil.which("gemini") is None:
        return "SKIP", "gemini not installed"
    r = subprocess.run(
        ["gemini", "extensions", "validate", "."],
        cwd=root, capture_output=True, text=True, timeout=SUBPROCESS_TIMEOUT,
    )
    return ("PASS", "") if r.returncode == 0 else ("FAIL", _tail(r))


CHECKS = [
    ("unit-tests", check_unit_tests),
    ("skill-names", check_skill_names),
    ("no-bin", check_no_bin),
    ("no-root-claude-md", check_no_root_claude_md),
    ("no-local-paths", check_no_local_paths),
    ("prose-rules", check_prose_rules),
    ("file-size", check_file_size),
    ("build-fresh", check_build_fresh),
    ("version-sync", check_version_sync),
    ("claude-validate", check_claude_validate),
    ("gemini-validate", check_gemini_validate),
]


def main(argv):
    if len(argv) > 1:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    root = Path(argv[0]).resolve() if argv else REPO_ROOT
    if (
        not root.is_dir()
        or not (root / "VERSION").is_file()
        or not (root / "kit.config.json").is_file()
    ):
        print(
            f"error: {root} is not a repo root; "
            "need a directory containing VERSION and kit.config.json",
            file=sys.stderr,
        )
        return 2
    failures = 0
    for name, fn in CHECKS:
        try:
            status, detail = fn(root)
        except Exception as e:
            status, detail = "FAIL", f"internal error: {e}"
        print(f"{status} {name}" + (f": {detail}" if detail else ""))
        if status == "FAIL":
            failures += 1
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
